# ================================================
#  Event-Driven Complaint System — Environment Vars
#  Copy this file to .env and fill in your values
# ================================================

# ---------- Kafka ----------
KAFKA_BROKER=

# ---------- Kafka Topics ----------
TOPIC_COMPLAINT_SUBMITTED=
TOPIC_COMPLAINT_VALIDATED=
TOPIC_COMPLAINT_CATEGORIZED=
TOPIC_COMPLAINT_ASSIGNED=
TOPIC_COMPLAINT_STATUS_UPDATED=

# ---------- Service URLs ----------
ML_SERVICE_URL=

# ---------- Service Ports (reference only) ----------
COMPLAINT_SERVICE_PORT=
ML_SERVICE_PORT=

# ---------- ML Model ----------
MODEL_DEVICE=

# ---------- Database (NeonDB / PostgreSQL) ----------
DATABASE_URL=

# ---------- JWT Authentication ----------
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# ==============================
# Email Service Configuration (SMTP)
# ==============================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
SENDER_NAME=Municipal Complaint System

# ==============================
# Cloudinary (Image Upload)
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=